# Copy to .env and fill in. (Named env.example, NOT .env.example, because the
# repo .gitignore ignores .env* — this file would be ignored otherwise.)

# --- Simli (the Trinity face) ---
SIMLI_API_KEY=
SIMLI_FACE_ID=5f911c8d-7b81-40f6-bed0-de435f02e10d

# --- LLM: Google Gemini (AI Studio key — https://aistudio.google.com) ---
# NOTE: this is a pay-as-you-go AI Studio API key, NOT your Workspace/Gemini Pro
# subscription. gemini-2.5-flash is the cheapest option.
GOOGLE_API_KEY=

# --- STT + TTS: Deepgram (one key covers both — https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- LiveKit Cloud (https://cloud.livekit.io → project → Settings → Keys) ---
# Same project as the Next.js token route. The worker reads these automatically.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
