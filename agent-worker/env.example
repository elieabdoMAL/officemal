# Copy to .env and fill in. (Named env.example, NOT .env.example, because the
# repo .gitignore ignores .env* — this file would be ignored otherwise.)

# --- Simli (the Trinity face) ---
SIMLI_API_KEY=
SIMLI_FACE_ID=3d1cf1cf-2374-4cb8-861c-33528b45b309

# How long the avatar stays connected, in seconds. Simli bills render time, so
# these end the session when the lobby empties. Optional — the worker defaults
# to 180 / 1800 if unset. Raise SIMLI_MAX_IDLE_TIME if she drops out while a
# visitor is still standing there thinking.
SIMLI_MAX_IDLE_TIME=180
SIMLI_MAX_SESSION_LENGTH=1800

# --- LLM: Google Gemini (AI Studio key — https://aistudio.google.com) ---
# NOTE: this is a pay-as-you-go AI Studio API key, NOT your Workspace/Gemini Pro
# subscription. gemini-2.5-flash is the cheapest option.
GOOGLE_API_KEY=

# --- STT + TTS: Deepgram (one key covers both — https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- Optional voice: ElevenLabs instead of Deepgram Aura (https://elevenlabs.io) ---
# Off unless TTS_PROVIDER=elevenlabs AND ELEVENLABS_API_KEY is set; otherwise
# she keeps the two Aura voices (Deepgram is still needed for her ears, STT).
# One multilingual voice speaks both French and English. Premade/library voices
# need a paid ElevenLabs plan for API use (free accounts get HTTP 402).
# push-keys.sh does not sync these: add them to the server's .env by hand.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# Voice id from the ElevenLabs Voice Library ("ID" button on a voice). Defaults
# to Aria, 9BWtsMINqrJLrRacOk9x (reported as a legacy voice that ElevenLabs may
# now serve as "Zoe": listen first, and paste another id if it isn't Aria).
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x
# Default eleven_flash_v2_5 (fastest, multilingual, told the language each
# turn). eleven_multilingual_v2 sounds a bit richer but is slower.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- LiveKit Cloud (https://cloud.livekit.io → project → Settings → Keys) ---
# Same project as the Next.js token route. The worker reads these automatically.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Session limits (optional; defaults shown) ---
# Ends the session (deletes the LiveKit room) after this much silence, and caps
# any single conversation. The kiosk hides her until the AI button is tapped.
# SESSION_IDLE_TIMEOUT=120
# SESSION_MAX_LENGTH=600
# After "stop talking" she stays paused until her name is said; if nobody says
# it for this long, the session ends quietly. Defaults to SESSION_IDLE_TIMEOUT.
# PAUSE_TIMEOUT=120

# --- Her name (optional; default Mia) ---
# Used in her prompt, the "say my name" line, the name that wakes her when
# paused, and on screen. "assistant" / "assistante" also wake her.
# ASSISTANT_NAME=Mia
# Name the kiosk's token route dispatches. Change both sides together (also
# LIVEKIT_AGENT_NAME on Vercel), or she never joins.
# LIVEKIT_AGENT_NAME=officemal-mia
